# Copy to .env and fill in. Never commit real values.
DATABASE_URL="mysql://USER:PASSWORD@HOST:4000/brevoclone"
APP_URL="http://localhost:3001"
FRONTEND_URL="http://localhost:5173"
JWT_SECRET=""

CLERK_SECRET_KEY=""
CLERK_PUBLISHABLE_KEY=""
VITE_CLERK_PUBLISHABLE_KEY=""
# Comma-separated Clerk user ids allowed in addition to the team list in server/index.ts
ALLOWED_USER_IDS=""

AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""
SES_FROM_EMAIL=""
SES_FROM_NAME=""
# Optional: exact SNS topic for SES events. Without it, any topic in this AWS account is accepted.
SNS_TOPIC_ARN=""

R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="attachment"
R2_PUBLIC_URL=""
