generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
}

enum ContactStatus {
  subscribed
  unsubscribed
  bounced
  complained
}

enum AudienceType {
  list
  segment
}

enum CampaignStatus {
  draft
  scheduled
  sending
  sent
  paused
}

enum EventType {
  sent
  delivered
  opened
  clicked
  bounced
  complained
  unsubscribed
  rejected
  rendering_failure
  delayed
}

model Contact {
  id          Int           @id @default(autoincrement())
  email       String        @unique
  firstName   String?
  lastName    String?
  fullName    String?
  phone       String?
  company     String?
  designation String?
  industry    String?
  website     String?
  country     String?
  city        String?
  address     String?
  linkedin    String?
  twitter     String?
  facebook    String?
  whatsapp    String?
  sms         String?
  notes       String?       @db.Text
  source      String?
  status      ContactStatus @default(subscribed)
  blocked     Boolean       @default(false)
  userId      String
  tags        String?
  ownerId     String?
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  contactLists ContactList[]
  emailEvents  EmailEvent[]
  contactAutomations ContactAutomation[]

  @@index([status])
  @@index([company])
  @@index([userId])
  @@map("contacts")
}

model Folder {
  id        Int      @id @default(autoincrement())
  brevoId   Int?     @unique
  userId    String
  name      String
  createdAt DateTime @default(now())
  lists     List[]

  @@index([userId])
  @@map("folders")
}

model List {
  id           Int           @id @default(autoincrement())
  brevoId      Int?          @unique
  userId       String
  name         String
  type         String?       @default("list")
  folderId     Int?
  createdAt    DateTime      @default(now())
  folder       Folder?       @relation(fields: [folderId], references: [id])
  contactLists ContactList[]

  @@index([userId])
  @@map("lists")
}

model ContactList {
  contactId Int
  listId    Int
  contact   Contact @relation(fields: [contactId], references: [id])
  list      List    @relation(fields: [listId], references: [id])

  @@id([contactId, listId])
  @@map("contact_lists")
}

model Campaign {
  id             Int            @id @default(autoincrement())
  name           String
  subject        String
  fromName       String
  fromEmail      String
  replyToEmail   String?
  replyToName    String?
  replyToListId  Int?
  previewText    String?
  userId         String
  templateHtml   String         @db.LongText
  audienceType   AudienceType
  audienceId     Int
  audienceListIds String?
  excludeListIds String?
  skipUnengaged  Boolean        @default(false)
  status         CampaignStatus @default(draft)
  scheduledAt    DateTime?
  sentAt         DateTime?
  totalRecipients Int           @default(0)
  createdAt      DateTime       @default(now())

  @@index([userId])
  @@map("campaigns")
}

model EmailEvent {
  id         Int       @id @default(autoincrement())
  email      String
  campaignId Int?
  eventType  EventType
  url        String?   @db.VarChar(2000)
  userAgent  String?   @db.VarChar(500)
  timestamp  DateTime  @default(now())
  contact    Contact?  @relation(fields: [email], references: [email])

  @@index([email])
  @@index([campaignId])
  @@index([eventType])
  @@index([timestamp])
  @@map("email_events")
}

model Automation {
  id        Int      @id @default(autoincrement())
  name      String
  trigger   String?
  userId    String
  stepsJson String?
  createdAt DateTime @default(now())
  contactAutomations ContactAutomation[]

  @@index([userId])
  @@map("automations")
}

model ContactAutomation {
  contactId     Int
  automationId  Int
  enrolledAt    DateTime @default(now())
  contact       Contact    @relation(fields: [contactId], references: [id])
  automation    Automation @relation(fields: [automationId], references: [id])

  @@id([contactId, automationId])
  @@map("contact_automations")
}

model Company {
  id                Int      @id @default(autoincrement())
  brevoId           String   @unique
  name              String
  domain            String?
  owner             String?
  phoneNumber       String?
  revenue           Float?
  industry          String?
  numberOfEmployees Int?
  numberOfContacts  Int      @default(0)
  linkedContactsIds Json?
  userId            String
  linkedDealsIds    Json?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([name])
  @@index([userId])
  @@map("companies")
}

model Segment {
  id           Int      @id @default(autoincrement())
  brevoId      Int      @unique
  name         String
  segmentType  String?
  userId       String
  contactCount Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([userId])
  @@map("segments")
}

model Template {
  id           Int      @id @default(autoincrement())
  name         String
  subject      String?
  contentHtml  String   @db.LongText
  userId       String
  previewText  String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([userId])
  @@map("templates")
}

model Sender {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  createdAt DateTime @default(now())

  @@map("senders")
}

model EmailDomain {
  id                 Int      @id @default(autoincrement())
  domain             String   @unique
  verificationStatus String   @default("Unverified")
  dkimStatus         String   @default("Unverified")
  dkimEnabled        Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@map("email_domains")
}
